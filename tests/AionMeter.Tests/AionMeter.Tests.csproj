<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.*" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AionMeter.App\Services\AppInfo.cs" Link="App\AppInfo.cs" />
    <Compile Include="..\..\src\AionMeter.App\Services\UiText*.cs" Link="App\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AionMeter.Core\AionMeter.Core.csproj" />
    <ProjectReference Include="..\..\src\AionMeter.Overlay\AionMeter.Overlay.csproj" />
  </ItemGroup>

</Project>